{
  "name": "angular-headless-cms",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postinstall": "copyfiles -u 4 \"node_modules/girondins33-design-system/dist/esm/*.js\" public/assets && copyfiles -u 3 \"node_modules/girondins33-design-system/dist/girondins33-design-system/**/*\" public/build/girondins33-design-system"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
